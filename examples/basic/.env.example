# Copy to .env next to this compose file: Compose reads .env from the
# compose file's directory. Set the variables here, not inline in the
# command.
# Comma-separated managed project patterns; required for every compose
# command against the file.
DEV_LEASE_PROJECTS=
# Time between sweeps (a Go duration). The default is 1m.
DEV_LEASE_INTERVAL=1m
# How long a stopped project is kept before removal (0: never).
# The default is 24h.
DEV_LEASE_REMOVE_AFTER=24h
#
# The up in the example scripts and the compose file's comments runs with
# --no-recreate, so an exited container is restarted as it is and an
# edited variable is NOT picked up. After changing a variable, recreate
# the container explicitly:
#   docker compose -p dev-lease -f <the compose file> up -d --force-recreate
# The dashboard is published on this host interface (default: 127.0.0.1,
# host-local only). To reach it from another machine, bind this machine's
# Tailscale address, or 172.17.0.1 to reach it from other containers on
# the same docker0 bridge. Never use 0.0.0.0 on a machine with a public
# interface: that publishes the dashboard on every interface. Put the
# same name or address into DEV_LEASE_DASHBOARD_HOSTS below, otherwise
# the Host check answers 403. The container listens on 8410.
DEV_LEASE_DASHBOARD_BIND=127.0.0.1
# Comma-separated Host allowlist: a request whose Host header is not on
# the list gets 403 (the port is ignored). Use the same name or address
# the bind publishes on: your Tailscale name, 172.17.0.1, localhost.
DEV_LEASE_DASHBOARD_HOSTS=localhost,127.0.0.1,[::1]
# Set it whenever DEV_LEASE_DASHBOARD_BIND is anything but 127.0.0.1:
# anyone who can reach the port can stop and remove the stacks, and a
# container on the docker0 bridge can too, unless the login is on.
# When set, the dashboard asks for this token at /login. Unset: no login.
# Generate one with: openssl rand -hex 32
# The token travels by environment only, never on the command line.
DEV_LEASE_DASHBOARD_TOKEN=
